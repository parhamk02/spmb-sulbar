	$query 	= "SELECT *, (SELECT GROUP_CONCAT(CONCAT(tb_komsarpras.nama_komsarpras) SEPARATOR ', ') from tb_peminjamandetail left join tb_komsarpras on tb_peminjamandetail.id_komsarpras=tb_komsarpras.id_komsarpras where tb_peminjamandetail.id_bukutamu=tb_peminjaman.id_bukutamu) as sarpras FROM tb_peminjaman inner join tb_bukutamu on tb_peminjaman.id_bukutamu=tb_bukutamu.id_bukutamu inner join tb_tamu on tb_bukutamu.id_tamu=tb_tamu.id_tamu where '$tgl' between CAST(tb_peminjaman.mulai AS DATE) and CAST(tb_peminjaman.sampai AS DATE) or '$tgl' between CAST(tb_peminjaman.mulai AS DATE) and CAST(tb_peminjaman.sampai AS DATE) or tb_peminjaman.sampai=CAST($tgl AS DATE) or tb_peminjaman.mulai=CAST($tgl AS DATE) order by tb_peminjaman.id_peminjaman desc";
	$result = $this->db->query($query);
	return $result;	
	}

function peminjaman_mingguini(){
	$tgl = date("Y-m-d");
	$query 	= "SELECT *, (SELECT GROUP_CONCAT(CONCAT(tb_komsarpras.nama_komsarpras) SEPARATOR ', ') from tb_peminjamandetail left join tb_komsarpras on tb_peminjamandetail.id_komsarpras=tb_komsarpras.id_komsarpras where tb_peminjamandetail.id_bukutamu=tb_peminjaman.id_bukutamu) as sarpras, (select instansi from tb_tamu inner join tb_bukutamu on tb_tamu.id_tamu=tb_bukutamu.id_tamu where tb_bukutamu.id_bukutamu=tb_peminjaman.id_bukutamu) as instansi FROM tb_peminjaman where MONTH(tb_peminjaman.mulai) = MONTH('$tgl') order by tb_peminjaman.mulai asc";
	$result = $this->db->query($query);
	return $result;	
	}


